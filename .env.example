# Copy to .env.local (never commit it). With no keys the app runs in MOCK + TEMPLATE mode.

# Qloo hackathon key (header X-Api-Key). Presence switches the app from mock fixtures to the live API.
QLOO_API_KEY=
# Optional override; hackathon keys only work against this host.
QLOO_BASE_URL=https://hackathon.api.qloo.com

# NVIDIA Nemotron on Nebius Token Factory (Bearer key). Enables the planner, wording, prompts,
# feedback loop and session scripts. Without it: deterministic planner + template wording.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Set NEMOTRON=off to force template mode even with a key.
NEMOTRON=
# Optional per-role model overrides (defaults shown).
# NEMOTRON_PLANNER_MODEL=nvidia/Nemotron-3-Ultra-550b-a55b
# NEMOTRON_WRITER_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_FEEDBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
# NEMOTRON_READER_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEMOTRON_PROMPTS_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# NEMOTRON_SCRIPT_MODEL=nvidia/Nemotron-3_5-Lightning
# NEMOTRON_PLANNER_BUDGET_MS=60000

# Optional: Tavily web search for local hometown history in the resident's decades. Skipped when absent.
TAVILY_API_KEY=
